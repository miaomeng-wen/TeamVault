# TeamVault 环境配置模板
# 复制本文件为 config/.env 后填写（.env 已被 .gitignore 排除，绝不入库）。
# skill 脚本读取顺序：环境变量 > 本文件。

# 团队 vault 根目录（skill 脚本定位 vault 用）
RESEARCH_VAULT=E:\TeamVault

# Zotero 群组库 ID：zotero.org 打开群组页，URL https://www.zotero.org/groups/XXXXXX 中的数字
ZOTERO_GROUP_ID=

# Zotero Web API Key：https://www.zotero.org/settings/keys/new 创建，勾选群组库的 Read 权限即可
ZOTERO_API_KEY=

# 本机 Zotero 本地 API 兜底（本机 Zotero 已同步群组库且离线可用）
ZOTERO_LOCAL_API=http://127.0.0.1:23119
